@startuml CurioDB Architecture
title CurioDB Component Architecture

skinparam componentStyle rectangle
skinparam shadowing false
top to bottom direction

actor User

package "SQL Frontend" {
  [CLI Shell] as CLI
  [Lexer] as Lexer
  [Parser] as Parser
  [AST] as AST
}

package "Query Processing" {
  [Statement Executor] as Executor
  [Binder / Planner] as Planner
  [Execution Operators] as Operators
}

package "Metadata" {
  [Catalog] as Catalog
  [Catalog Storage] as CatalogStorage
}

package "Storage Engine" {
  [Table Heap] as TableHeap
  [B+ Tree] as BPlusTree
  [Buffer Pool] as BufferPool
  [Slotted Page] as SlottedPage
  [Disk Manager] as DiskManager
}

User --> CLI : SQL and meta-commands
CLI --> Lexer : SQL text
Lexer --> Parser : tokens
Parser --> AST : statements and expressions
CLI --> Executor : execute AST
Executor --> Planner : plan SELECT
Planner --> Catalog : bind names and types
Planner --> Operators : physical plan
Executor --> Catalog : schema and database metadata
Executor --> TableHeap : row operations
Executor --> BPlusTree : indexed lookup
Operators --> TableHeap : sequential scan
Operators --> BPlusTree : index scan
CatalogStorage --> DiskManager : persist metadata
TableHeap --> BufferPool : fetch and modify pages
BPlusTree --> BufferPool : fetch and modify nodes
TableHeap --> SlottedPage : store serialized rows
BufferPool --> DiskManager : page I/O

note right of Planner
  Equality on an indexed INT column
  selects IndexScan. Other predicates
  select SequentialScan.
end note

@enduml
